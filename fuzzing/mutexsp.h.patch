 #define MUTEX_INIT_SEMVAL		LOCK_AVAILABLE
-#define MUTEX_CONST_TIMEOUT_VAL		16
+/* Use a 1 second timeout during fuzz testing (instead of 16 seconds) so a process waiting for crit checks for and

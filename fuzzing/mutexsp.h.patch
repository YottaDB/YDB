+ * waiting process too on its own 5 second timeout. Otherwise every later process waits for crit until it is killed.
+ * MUTEXLCKALERT_INTERVAL (see fuzzing/mutex.h.patch) has to be twice this value.
+ */
+#define MUTEX_CONST_TIMEOUT_VAL		1
 
 #define HUNDRED_MSEC 			100000
 

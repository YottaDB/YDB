+++ b/sr_unix/util_output.c
@@ -20,6 +20,11 @@
 #include <stdarg.h>
 #include "gtm_stdio.h"
 #include "gtm_syslog.h"
+#include "gtm_fcntl.h"
+#include "gtm_stat.h"
+#include "gtm_time.h"

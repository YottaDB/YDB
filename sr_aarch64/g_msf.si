#-----------------------------------------------
# Mumps stack frame manipulation macros
#  for the GNU gas arm assembler version
#-----------------------------------------------

msf_rvector_off		=	0
msf_l_symtab_off	=	8
msf_mpc_off		=	16
msf_ctxt_off		=	24
msf_literal_ptr_off	=	32
msf_temps_ptr_off	=	40
msf_vartab_ptr_off	=	48
msf_old_frame_off	=	56
msf_vartab_len_off	=	64
msf_temp_mvals_off	=	66
msf_typ_off		=	68
msf_flags_off		=	70
msf_for_ctrl_stack	=	72
msf_restart_pc_off	=	80
msf_restart_ctxt_off	=	88
msf_frame_size		=	104

SFT_COUNT		=	0x01
SFT_DM			=	0x02
SFT_REP_OP		=	0x04
SFT_ZBRK_ACT		=	0x08
SFT_DEV_ACT		=	0x10
SFT_ZTRAP		=	0x20
SFT_ZTIMEOUT            =       0x40
SFT_ZSTEP_ACT		=	0x80
SFT_ZINTR		=	0x100

SFF_INDCE		=	0x01
SFF_ZTRAP_ERR		=	0x02
SFF_DEV_ACT_ERR		=	0x04
SFF_ETRAP_ERR		=	0x08
SFF_RSB_ENTRY		=	0x40

.macro putframe
	ldr	x9, [x19]
	str	x21, [x9, #msf_temps_ptr_off]
	str	x20, [x9, #msf_l_symtab_off]
	str	x22, [x9, #msf_literal_ptr_off]
	str	x24, [x9, #msf_ctxt_off]
	str	X30, [x9, #msf_mpc_off]
.endm

.extern	error_return

.macro getframe
	ldr	x9, [x19]
	ldrb	w13, [x9, #msf_flags_off]
	tst	w13,  #SFF_ETRAP_ERR
	beq	1f
	bl	error_return
	ldr	x9, [x19]
1:
	ldr	x21, [x9, #msf_temps_ptr_off]
	ldr	x20, [x9, #msf_l_symtab_off]
	ldr	x22, [x9, #msf_literal_ptr_off]
	ldr	x24, [x9, #msf_ctxt_off]
	ldr	X30, [x9, #msf_mpc_off]
.endm

#
# Field for routine header - offsets must match rtnhdr.h
#
mrt_jsb			=	0
mrt_shlib_handle	=	16
mrt_src_len		=	28
mrt_src_addr		=	32
mrt_compiler_qlf	=	40
mrt_obj_label		=	44
mrt_rtn_len		=	52
mrt_rtn_addr		=	56
mrt_var_ptr		=	64
mrt_var_len		=	72
mrt_lab_ptr		=	80
mrt_lab_len		=	88
mrt_lnr_ptr		=	96
mrt_lnr_len		=	104
mrt_lit_ptr		=	128
mrt_lnk_ptr		=	144
mrt_ptext_adr		=	176
mrt_tmp_mv		=	196
mrt_tmp_sz		=	200
mrt_curr_ptr		=	208
mrt_oldr_ptr		=	216
mrt_zhist		=	264

/* Set SFF_RSB_ENTRY in the frame on top of the M stack (see stack_frame.h). Use when the bl that entered this routine
 * stays on the return stack, because this routine transfers control to the new frame on top of the M stack with a br.
 * Uses x9 and w10.
 */
.macro mark_rsb_entry
	ldr	x9, [x19]
	ldrb	w10, [x9, #msf_flags_off]
	orr	w10, w10, #SFF_RSB_ENTRY
	strb	w10, [x9, #msf_flags_off]
.endm

/* Load the registers of the frame on top of the M stack and transfer control to its mpc, with a ret if \flagsreg (the
 * flags of the frame that was just unwound) has SFF_RSB_ENTRY set, or else with a br. See stack_frame.h for why. Use to
 * return from a frame to the previous frame.
 */
.macro getframe_ret_or_br flagsreg
	getframe
	tst	\flagsreg, #SFF_RSB_ENTRY
	b.eq	3f
	ret
3:
	br	x30
.endm
